# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore[cite: 1]
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.[cite: 1]
# See: https://github.com/github/gitignore/tree/main/Global[cite: 1]
#
.utmp/[cite: 1]
/[Ll]ibrary/[cite: 1]
/[Tt]emp/[cite: 1]
/[Oo]bj/[cite: 1]
/[Bb]uild/[cite: 1]
/[Bb]uilds/[cite: 1]
/[Ll]ogs/[cite: 1]
/[Uu]ser[Ss]ettings/[cite: 1]
*.log[cite: 1]

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.[cite: 1]
*.blend1[cite: 1]
*.blend1.meta[cite: 1]

# MemoryCaptures can get excessive in size.[cite: 1]
# They also could contain extremely sensitive data[cite: 1]
/[Mm]emoryCaptures/[cite: 1]

# Recordings can get excessive in size[cite: 1]
/[Rr]ecordings/[cite: 1]

# Uncomment this line if you wish to ignore the asset store tools plugin[cite: 1]
# /[Aa]ssets/AssetStoreTools*[cite: 1]

# Autogenerated Jetbrains Rider plugin[cite: 1]
/[Aa]ssets/Plugins/Editor/JetBrains*[cite: 1]
# Jetbrains Rider personal-layer settings[cite: 1]
*.DotSettings.user[cite: 1]

# Visual Studio cache directory[cite: 1]
.vs/[cite: 1]

# Gradle cache directory[cite: 1]
.gradle/[cite: 1]

# Autogenerated VS/MD/Consulo solution and project files[cite: 1]
ExportedObj/[cite: 1]
.consulo/[cite: 1]
*.csproj[cite: 1]
*.unityproj[cite: 1]
*.sln[cite: 1]
*.slnx[cite: 1]
*.suo[cite: 1]
*.tmp[cite: 1]
*.user[cite: 1]
*.userprefs[cite: 1]
*.pidb[cite: 1]
*.booproj[cite: 1]
*.svd[cite: 1]
*.pdb[cite: 1]
*.mdb[cite: 1]
*.opendb[cite: 1]
*.VC.db[cite: 1]

# Unity3D generated meta files[cite: 1]
*.pidb.meta[cite: 1]
*.pdb.meta[cite: 1]
*.mdb.meta[cite: 1]

# Unity3D generated file on crash reports[cite: 1]
sysinfo.txt[cite: 1]

# Mono auto generated files[cite: 1]
mono_crash.*[cite: 1]

# Builds[cite: 1]
*.apk[cite: 1]
*.aab[cite: 1]
*.unitypackage[cite: 1]
*.unitypackage.meta[cite: 1]
*.app[cite: 1]

# Crashlytics generated file[cite: 1]
crashlytics-build.properties[cite: 1]

# TestRunner generated files[cite: 1]
InitTestScene*.unity*[cite: 1]

# Addressables default ignores, before user customizations[cite: 1]
/ServerData[cite: 1]
/[Aa]ssets/StreamingAssets/aa*[cite: 1]
/[Aa]ssets/AddressableAssetsData/link.xml*[cite: 1]
/[Aa]ssets/Addressables_Temp*[cite: 1]
# By default, Addressables content builds will generate addressables_content_state.bin[cite: 1]
# files in platform-specific subfolders, for example:[cite: 1]
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin[cite: 1]
/[Aa]ssets/AddressableAssetsData/*/*.bin*[cite: 1]

# Visual Scripting auto-generated files[cite: 1]
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db[cite: 1]
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta[cite: 1]
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers[cite: 1]
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta[cite: 1]

# Auto-generated scenes by play mode tests[cite: 1]
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*[cite: 1]

# Auto-generated cache in Assets folder[cite: 1]
/[Aa]ssets/[Ss]ceneDependencyCache*[cite: 1]